# Production pb_data and backups never belong in the repository (D20).
/pb_data/
/*.zip

# Dependencies and build output.
/node_modules/
/dist/

# Reference tools and the upstream source checkout (bun run upstream:prepare).
/.upstream
/.upstream.*

# Dashboard build output and dependencies (bun run ui:build).
/ui/dist/
/ui/node_modules/

# SDK build output (bun run sdk:build).
/sdk/dist/
/sdk/node_modules/

# Example apps (examples/, bun run test:examples): dependencies and build output.
/examples/*/node_modules/
/examples/*/.next/
/examples/*/.svelte-kit/
/examples/*/build/
/examples/*/next-env.d.ts
