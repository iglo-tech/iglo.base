{
  "name": "@iglo.tech/iglo.base",
  "version": "1.0.1",
  "description": "JavaScript SDK for iglo.base (fork of the PocketBase JavaScript SDK v0.28.1)",
  "keywords": [
    "iglo.base",
    "javascript-sdk",
    "js-sdk",
    "pocketbase",
    "pocketbase-js"
  ],
  "license": "MIT",
  "author": "Gani Georgiev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iglo-tech/iglo.base.git",
    "directory": "sdk"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/iglo-base.es.mjs",
  "module": "./dist/iglo-base.es.mjs",
  "types": "./dist/types/src/index.d.ts",
  "react-native": "./dist/iglo-base.es.mjs",
  "exports": {
    ".": {
      "types": "./dist/types/src/index.d.ts",
      "default": "./dist/iglo-base.es.mjs"
    },
    "./ssr": {
      "types": "./dist/types/src/ssr/index.d.ts",
      "browser": "./dist/ssr-browser.es.mjs",
      "default": "./dist/ssr.es.mjs"
    },
    "./ssr/browser": {
      "types": "./dist/types/src/ssr/browser-client.d.ts",
      "default": "./dist/ssr-browser-client.es.mjs"
    },
    "./ssr/next": {
      "types": "./dist/types/src/ssr/next.d.ts",
      "browser": "./dist/ssr-browser.es.mjs",
      "default": "./dist/ssr-next.es.mjs"
    },
    "./ssr/sveltekit": {
      "types": "./dist/types/src/ssr/sveltekit.d.ts",
      "browser": "./dist/ssr-browser.es.mjs",
      "default": "./dist/ssr-sveltekit.es.mjs"
    },
    "./ssr/nuxt": {
      "types": "./dist/types/src/ssr/nuxt.d.ts",
      "browser": "./dist/ssr-browser.es.mjs",
      "default": "./dist/ssr-nuxt.es.mjs"
    },
    "./ssr/astro": {
      "types": "./dist/types/src/ssr/astro.d.ts",
      "browser": "./dist/ssr-browser.es.mjs",
      "default": "./dist/ssr-astro.es.mjs"
    },
    "./ssr/react-router": {
      "types": "./dist/types/src/ssr/react-router.d.ts",
      "browser": "./dist/ssr-browser.es.mjs",
      "default": "./dist/ssr-react-router.es.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  }
}
