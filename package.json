{
  "name": "iglo.base-server",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "sdk"
  ],
  "type": "module",
  "scripts": {
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "bun run sdk:build && tsc --noEmit && tsc --noEmit -p sdk/tsconfig.json && tsc --noEmit -p sdk/test/tsconfig.json",
    "test": "bun test --timeout 120000",
    "build": "bun scripts/build.ts && bun run sdk:build",
    "ui:build": "bun scripts/ui/build.ts",
    "check": "bun run lint && bun run format:check && bun run typecheck && bun run test && bun run build && bun run sdk:check-package",
    "hooks:install": "sh scripts/install-git-hooks.sh",
    "upstream:prepare": "bun scripts/upstream/prepare.ts",
    "test:reference": "bun run sdk:build && bun run upstream:prepare && bun test --timeout 120000 --path-ignore-patterns \"\" test/differential",
    "test:browser": "bun test --timeout 120000 --path-ignore-patterns \"\" test/browser",
    "test:examples": "bun run sdk:build && bun run upstream:prepare && bun test --timeout 900000 --path-ignore-patterns \"\" test/examples",
    "test:roundtrip:large": "bun run upstream:prepare && bun --preload ./test/differential/fuzz/temp-root.ts test/differential/roundtrip/large.ts",
    "fuzz:filters": "bun run upstream:prepare && bun --preload ./test/differential/fuzz/temp-root.ts test/differential/fuzz/main.ts",
    "sdk:build": "bun sdk/scripts/build.ts",
    "sdk:check-package": "bun sdk/scripts/check-package.ts"
  },
  "dependencies": {
    "nodemailer": "10.3.1"
  },
  "devDependencies": {
    "@iglo.tech/iglo.base": "workspace:*",
    "@types/bun": "1.4.4",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "packageManager": "bun@1.4.4"
}
